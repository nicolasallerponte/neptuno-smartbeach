# FIWARE endpoints (localhost because scripts run on the host)
ORION_URL=http://localhost:1026
QUANTUMLEAP_URL=http://localhost:8668
IOT_AGENT_NORTH_URL=http://localhost:4041
IOT_AGENT_HTTP_URL=http://localhost:7896
CRATE_URL=http://localhost:4200
CRATE_HOST=localhost
CRATE_PORT=4200

# NGSI-LD
NGSILD_TENANT=smartbeach
CONTEXT_URL=http://context/user-context.jsonld

# Grafana (change the password)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=neptuno2026

# Ollama — must run on the host (https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# FastAPI backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Simulator update intervals (seconds)
SEA_CONDITIONS_INTERVAL=600
WEATHER_OBSERVED_INTERVAL=3600
WEATHER_FORECAST_INTERVAL=21600
WATER_QUALITY_INTERVAL=43200

# IoT Agent internal key (any string, must match init_orion.py)
IOT_API_KEY=neptuno-smartbeach-2026
SERVICE_PATH=/

# MeteoSIX API key — forecasts only (optional, system falls back to simulation)
# Request at: sistemas@meteogalicia.gal (free for academic use)
METEOSIX_API_KEY=

# Windy Webcams API key — used to discover cameras near beaches
# Free registration at https://api.windy.com/webcams
WINDY_API_KEY=
